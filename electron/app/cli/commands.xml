<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <views>
        <view name="user">
            <prompt>&lt;NetNexus&gt;</prompt>
        </view>
        <view name="config">
            <prompt>&lt;NetNexus(config)&gt;</prompt>
        </view>
    </views>

    <!-- Command group definitions -->
    <command_groups>
        <!-- show cli command-info -->
        <group group-id="show-cli-command-info">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>command-info</name>
                    <description>Command info</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                    <description>Display registered CLI commands</description>
                </command>
            </commands>
        </group>

        <!-- show cli history -->
        <group group-id="show-cli-history">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>history</name>
                    <description>Command history</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                    <description>Display command history</description>
                </command>
            </commands>
        </group>

        <!-- show cli client -->
        <group group-id="show-cli-client">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>cli</name>
                    <description>CLI information</description>
                </element>
                <element id="3" type="keyword">
                    <name>client</name>
                    <description>Connected CLI clients</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                    <description>Display connected CLI clients</description>
                </command>
            </commands>
        </group>

        <!-- config -->
        <group group-id="config">
            <elements>
                <element id="1" type="keyword">
                    <name>config</name>
                    <description>Enter configuration mode</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>user</views>
                    <description>Enter configuration mode</description>
                </command>
            </commands>
        </group>

        <!-- end -->
        <group group-id="end">
            <elements>
                <element id="1" type="keyword">
                    <name>end</name>
                    <description>Return to user view</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                    <description>Return to user view</description>
                </command>
            </commands>
        </group>

        <!-- exit -->
        <group group-id="exit">
            <elements>
                <element id="1" type="keyword">
                    <name>exit</name>
                    <description>Exit current mode or close current session</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1</expression>
                    <views>global</views>
                    <description>Exit current mode or close current session</description>
                </command>
            </commands>
        </group>

        <!-- terminal length 0 -->
        <group group-id="terminal-length-disable">
            <elements>
                <element id="1" type="keyword">
                    <name>terminal</name>
                    <description>Session terminal settings</description>
                </element>
                <element id="2" type="keyword">
                    <name>length</name>
                    <description>Terminal paging length</description>
                </element>
                <element id="3" type="keyword">
                    <name>0</name>
                    <description>Disable paging</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                    <description>Disable paging for current session</description>
                </command>
            </commands>
        </group>

        <!-- no terminal length 0 -->
        <group group-id="terminal-length-default">
            <elements>
                <element id="1" type="keyword">
                    <name>no</name>
                    <description>Restore default setting</description>
                </element>
                <element id="2" type="keyword">
                    <name>terminal</name>
                    <description>Session terminal settings</description>
                </element>
                <element id="3" type="keyword">
                    <name>length</name>
                    <description>Terminal paging length</description>
                </element>
                <element id="4" type="keyword">
                    <name>0</name>
                    <description>Default paging length</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3 4</expression>
                    <views>global</views>
                    <description>Restore default paging for current session</description>
                </command>
            </commands>
        </group>

        <!-- show api status -->
        <group group-id="show-api-status">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>api</name>
                    <description>API service information</description>
                </element>
                <element id="3" type="keyword">
                    <name>status</name>
                    <description>Service status</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                    <description>Display HTTP API and telnet CLI service status</description>
                </command>
            </commands>
        </group>

        <!-- show bmp status -->
        <group group-id="show-bmp-status">
            <elements>
                <element id="1" type="keyword">
                    <name>show</name>
                    <description>Display system information</description>
                </element>
                <element id="2" type="keyword">
                    <name>bmp</name>
                    <description>BMP information</description>
                </element>
                <element id="3" type="keyword">
                    <name>status</name>
                    <description>BMP worker status</description>
                </element>
            </elements>

            <commands>
                <command>
                    <expression>1 2 3</expression>
                    <views>global</views>
                    <description>Display BMP worker status</description>
                </command>
            </commands>
        </group>

        <!-- show bmp client [client-id <clientId>] [verbose] -->
        <group group-id="show-bmp-client">
