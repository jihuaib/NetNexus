                </element>
                <element id="5" cfg-id="1" type="parameter">
                    <name>&lt;clientId&gt;</name>
                    <description>BMP client ID</description>
                    <type>uint(1-65535)</type>
                </element>
                <element id="6" cfg-id="2" type="keyword">
                    <name>verbose</name>
