                <command>
                    <expression>1 2 3 4 5</expression>
                    <views>global</views>
                    <description>Display BMP client summary by client-id</description>
                </command>
                <command>
                    <expression>1 2 3 4 5 6</expression>
                    <views>global</views>
                    <description>Display BMP client verbose information by client-id</description>
